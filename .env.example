# CubixGear Company Panel
# Copy this file to .env.local for local development.
#
# Production:
#   VITE_USE_MOCK_API=false
#   VITE_API_URL=https://api.your-domain.com/api/v1
#
# Local demo/development without backend:
#   VITE_USE_MOCK_API=true

VITE_USE_MOCK_API=false
VITE_API_URL=https://api.example.com/api/v1
VITE_API_TIMEOUT=15000
VITE_API_WITH_CREDENTIALS=false

VITE_APP_NAME=CubixGear Company Panel
VITE_APP_VERSION=1.0.0

# Never put API secrets, storage secret keys, payment gateway secrets,
# database credentials, private tokens, GST/NIC private credentials,
# SMTP passwords, or other server-side secrets in VITE_* variables.
# Every VITE_* value is bundled into the browser application.
